# Supabase — берётся из Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic — берётся из console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Email-уведомления через Resend (необязательно)
RESEND_API_KEY=
NOTIFY_ADMIN_EMAIL=

# URL приложения (без слэша в конце)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Wazzup (WhatsApp-бот)
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=   # ID канала для исходящих уведомлений клиентам

# Sentry — error tracking (sentry.io → Settings → Projects → DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=mglass-app
SENTRY_AUTH_TOKEN=   # Settings → Auth Tokens → Create (нужен для source maps)
