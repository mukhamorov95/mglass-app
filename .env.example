# Supabase — берётся из Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic — берётся из console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Email-уведомления через Resend (необязательно)
RESEND_API_KEY=
NOTIFY_ADMIN_EMAIL=

# URL приложения (без слэша в конце)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Wazzup (WhatsApp-бот)
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=   # ID канала для исходящих уведомлений клиентам

# Sentry — error tracking (sentry.io → Settings → Projects → DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=mglass-app
SENTRY_AUTH_TOKEN=   # Settings → Auth Tokens → Create (нужен для source maps)

# Avito Messenger API (AI-менеджер Авито): ключи из developers.avito.ru → «Мои приложения»
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Секрет вебхука: /api/avito/webhook?key=<этот секрет>
AVITO_WEBHOOK_SECRET=

# Телефония. Единая кнопка «Позвонить» (/api/call) выбирает провайдера по env:
# если задан OnlinePBX — звонит через него, иначе фолбэк на SIPUNI.

# OnlinePBX (облачная АТС) — приоритетный провайдер
ONLINEPBX_DOMAIN=pbx12210.onpbx.ru   # домен кабинета
ONLINEPBX_API_KEY=                    # auth_key HTTP API (нужен только для click-to-call)
ONLINEPBX_DEFAULT_EXT=100             # внутренний номер по умолчанию (Семён)
# Секрет вебхука событий/записей: /api/onlinepbx/webhook?key=<этот секрет>
ONLINEPBX_WEBHOOK_SECRET=

# SIPUNI (легаси, фолбэк если OnlinePBX не настроен)
SIPUNI_ID=                 # номер аккаунта (кабинет)
SIPUNI_API_KEY=            # ключ интеграции
SIPUNI_DEFAULT_SIPNUMBER=  # внутренний номер по умолчанию (напр. 201)

# Личный контур владельца (/vlad) — ОТДЕЛЬНЫЙ проект Supabase vlad-personal.
# Ключи этой базы живут только на сервере, клиентских нет вообще.
VLAD_SUPABASE_URL=
VLAD_SUPABASE_SERVICE_KEY=
VLAD_PIN=95
