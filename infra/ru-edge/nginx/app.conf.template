# Российская точка входа M-Glass App (маршрут docs/RUSSIA_ACCESS_ROUTE.md, Э2).
# Люди подключаются к российскому IP, зарубежный отрезок до Vercel идёт из дата-центра.
# Переменные подставляет setup.sh: __DOMAIN__, __UPSTREAM_HOST__, __UPSTREAM_SERVERS__(_HTTP__).
#
# __UPSTREAM_HOST__ — Host и SNI для Vercel. Штатно = __DOMAIN__ (домен подключён к проекту
# Vercel). Запасной режим без подключения домена — mglass-app.vercel.app: тогда редиректы
# переписывает proxy_redirect ниже, а next.config должен разрешать __DOMAIN__ в
# serverActions.allowedOrigins.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream vercel {
__UPSTREAM_SERVERS__
    keepalive 32;
}

# Тот же Vercel по HTTP — только для выпуска его сертификата (HTTP-01 приходит на порт 80).
upstream vercel_http {
__UPSTREAM_SERVERS_HTTP__
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Свои токены Let's Encrypt отдаём с диска, чужие (выпуск сертификата у Vercel) — Vercel'у.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri @vercel_http;
    }
    location @vercel_http {
        proxy_pass http://vercel_http;
        proxy_set_header Host __UPSTREAM_HOST__;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 60m;   # фото замеров и чертежи

    location / {
        proxy_pass https://vercel;
        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;

        proxy_set_header Host __UPSTREAM_HOST__;
        proxy_ssl_server_name on;
        proxy_ssl_name __UPSTREAM_HOST__;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_session_reuse on;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host __DOMAIN__;

        proxy_redirect https://__UPSTREAM_HOST__/ https://__DOMAIN__/;

        # RSC и потоковые ответы Next.js — отдаём по мере прихода, не копим.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Первый адрес Vercel не ответил — пробуем следующий, пока запрос не начал уходить.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
    }
}
