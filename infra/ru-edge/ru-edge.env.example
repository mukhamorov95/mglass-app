# Копировать в /etc/mglass/ru-edge.env на сервере, права 600. В репозиторий с настоящими значениями не класть.
DOMAIN=app.mglass.pro
# Публичный anon-ключ Supabase (тот же, что NEXT_PUBLIC_SUPABASE_ANON_KEY) — для пробы /auth/v1/health.
ANON_KEY=
# Строка подключения session pooler Supabase (Settings → Database → Session pooler, порт 5432):
# postgresql://postgres.<ref>:<пароль БД>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Бот и чат для сигналов (можно тот же бот, что у приложения; чат — владелец).
TG_TOKEN=
TG_CHAT=
